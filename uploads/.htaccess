# ====================================================================
# ADISOMA Solution - Uploads Directory Security (.htaccess)
# ====================================================================

# Disable directory browsing
Options -Indexes

# Block execution of all scripts across all handler types (FastCGI, FPM, CGI, mod_php)
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|inc|cgi|pl|py|sh|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Fallback for mod_php engines
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
